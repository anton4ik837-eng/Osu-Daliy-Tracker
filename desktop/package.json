{
  "name": "osu-daily-tracker-desktop",
  "version": "4.15.1",
  "private": true,
  "description": "Desktop build of osu! Daily Tracker Replay Lab",
  "homepage": "https://github.com/anton4ik837-eng/Osu-Daliy-Tracker",
  "author": {
    "name": "anton4ik837-eng",
    "email": "278468595+anton4ik837-eng@users.noreply.github.com"
  },
  "main": "main.js",
  "scripts": {
    "prepare:www": "node prepare.js",
    "build:win": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.osudailytracker.desktop",
    "productName": "osu! Daily Tracker",
    "protocols": [
      { "name": "osu! Daily Tracker", "schemes": ["osudailytracker"] }
    ],
    "files": [
      "main.js",
      "preload.js",
      "www/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "linux": {
      "category": "Game",
      "maintainer": "anton4ik837-eng <278468595+anton4ik837-eng@users.noreply.github.com>",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ]
    }
  }
}
